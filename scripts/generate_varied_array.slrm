#!/bin/bash
#
#SBATCH -J datagen-varied
#SBATCH --time="4:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --array=0-7
#SBATCH --requeue
#SBATCH -o logs/%x-%A_%a.out

set -euo pipefail

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task $SLURM_ARRAY_TASK_ID"

# the training dataset: one shard per array task, llg_<split>_<shard>.hdf5
OUT=datasets/llg_field_switching

uv run python -m datagen.generate_varied_field \
    --n-train 256 \
    --n-valid 32 \
    --n-test 8 \
    --out "$OUT" \
    --seed 0 \
    --shard "$SLURM_ARRAY_TASK_ID" \
    --n-shards "${SLURM_ARRAY_TASK_COUNT:-8}"

echo "when the whole array is done, sum the parts into stats.yaml:"
echo "  uv run python -m datagen.generate_varied_field --out $OUT --merge-stats"
