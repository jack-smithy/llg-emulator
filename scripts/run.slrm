#!/bin/bash
#
#SBATCH -J train_llg
#SBATCH -n 1
#SBATCH --time="0:20:00"
#SBATCH --partition=zen4_0768_h100x4
#SBATCH --qos=zen4_0768_h100x4
#SBATCH --mail-type=ALL
#SBATCH --gres=gpu:1
#SBATCH --requeue
#SBATCH -o logs/train2.log
#SBATCH --mail-user=jack.smith@univie.ac.at

uv run train \
    --seed 0 \
    --epochs 10 \
    --batch-size 8 \
    --learning-rate 3e-4 \
    --cosine \
    --weight-decay 1e-5 \
    --grad-clip 1.0 \
    --hidden-channels 64 \
    --num-blocks 4 \
    --checkpoint-every 2 \
    --out weights/best.eqx \
    --size med \
    --wandb-mode online 