#!/bin/bash
#
#SBATCH -J train_llg
#SBATCH -n 1
#SBATCH --time="2:00:00"
#SBATCH --partition=zen4_0768_h100x4
#SBATCH --qos=zen4_0768_h100x4
#SBATCH --mail-type=ALL
#SBATCH --gres=gpu:1
#SBATCH --requeue
#SBATCH -o train.log
#SBATCH --mail-user=jack.smith@univie.ac.at

uv run train \
    --epochs 64 \
    --batch-size 20 \
    --learning-rate 0.00001 \
    --size small \
    --wandb-mode online 