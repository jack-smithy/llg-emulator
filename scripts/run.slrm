#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="8:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --requeue
#SBATCH -o logs/train_small.log

# data/{train,val}/<variant>/ is picked up automatically; val/sp4 is held out of
# the val loss and used as the rollout benchmark (different mesh, OOD field).
uv run train \
    --epochs 12 \
    --batch-size 8 \
    --learning-rate 3e-4 \
    --cosine \
    --weight-decay 1e-5 \
    --grad-clip 1.0 \
    --hidden-channels 64 \
    --num-blocks 4 \
    --checkpoint-every 5 \
    --out weights/run-small \
    --wandb-mode disabled \
    --max-train-trajectories 128 \
    --max-val-trajectories 64 \
