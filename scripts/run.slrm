#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="1:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --requeue
#SBATCH -o logs/train.log

uv run train \
    --epochs 16 \
    --batch-size 8 \
    --learning-rate 1e-4 \
    --out results \
    --size large \
    --checkpoint-every 4 \
    --wandb-mode disabled
