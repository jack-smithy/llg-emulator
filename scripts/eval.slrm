#!/bin/bash
#
#SBATCH -J eval_llg
#SBATCH --time="2:00:00"
#SBATCH --gres=gpu:full:1
#SBATCH --requeue
#SBATCH -o logs/eval-%j.log

# gpu:full, not a MIG slice: data/val/large is 2001x2001 nodal and one forward
# pass at hidden 64 holds ~1 GB per feature map.
uv run python -m llg_emulator.evaluate \
    --model-path "${MODEL:-weights/run1}" \
    --tag "${TAG:-best}" \
    --vtr
