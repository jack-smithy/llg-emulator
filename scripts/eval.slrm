#!/bin/bash
#
#SBATCH -J eval-large
#SBATCH --time="1:00:00"
#SBATCH --mem=8G
#SBATCH -o logs/%x-%j.out


CONFIGURATION="test-factorized"

pids=()
for SEED in {0..3}; do
    uv run eval.py --configuration "$CONFIGURATION" --seed "$SEED" &
    pids+=($!)
done

for pid in "${pids[@]}"; do
    wait "$pid" || echo "pid $pid failed with $?"
done