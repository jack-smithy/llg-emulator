#!/bin/bash
#
#SBATCH -J train-demag
#SBATCH --time="8:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --array=0-1
#SBATCH -o logs/%x-%A_%a.out

export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95

set -euo pipefail

DATASET="llg_field_switching"
IN_FRAMES=${IN_FRAMES:-1}  # frames of context; submit with sbatch --export=ALL,IN_FRAMES=4
CONFIGURATION="demag-in$IN_FRAMES"  # plain model + the exact demag field as inputs, no solver
LEARNING_RATE=1e-3
BATCH_SIZE=32
NUM_STEPS=10000
VAL_EVERY=1000
HIDDEN_CHANNELS=64
NUM_BLOCKS=2
POOL_FACTORS="1 2 4 8"  # integer cell-size multiples, one drawn per batch


echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task: $SLURM_ARRAY_TASK_ID"
echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Steps=$NUM_STEPS, val every $VAL_EVERY"
echo "Model: hidden channels=$HIDDEN_CHANNELS, blocks=$NUM_BLOCKS, pool factors=$POOL_FACTORS, demag inputs, in frames=$IN_FRAMES"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --num-steps $NUM_STEPS \
    --val-every $VAL_EVERY \
    --hidden-channels $HIDDEN_CHANNELS \
    --num-blocks $NUM_BLOCKS \
    --pool-factors $POOL_FACTORS \
    --use-demag \
    --in-frames $IN_FRAMES

echo "Model Finished Training"

uv run eval.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --dataset $DATASET \
    --configuration $CONFIGURATION
