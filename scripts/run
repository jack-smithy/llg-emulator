CUDA_VISIBLE_DEVICES=3 uv run train \
    --seed 0 \
    --epochs 64 \
    --batch-size 16 \
    --learning-rate 1e-4 \
    --cosine \
    --weight-decay 1e-5 \
    --grad-clip 1.0 \
    --hidden-channels 64 \
    --num-blocks 4 \
    --checkpoint-every 4 \
    --out results/weights \
    --size small \
    --wandb-mode disabled 
