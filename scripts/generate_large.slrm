#!/bin/bash
#
#SBATCH -J datagen-large
#SBATCH --time="12:00:00"
#SBATCH --gres=gpu:full:1
#SBATCH --mem=32G
#SBATCH --requeue
#SBATCH -o logs/%x-%j.out

set -euo pipefail

DATASET="llg_field_switching"

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"

# One N x N s-state trajectory under the SP4 field, written as a `test` split under
# datasets/$DATASET/large; N is set in datagen/generate_large.py to the largest film both
# magnum.np and the FNO fit on a full GPU. Extra sbatch arguments pass through, e.g.
# `sbatch scripts/generate_large.slrm --n 1024`.
uv run python -m datagen.generate_large --out datasets/$DATASET/large "$@"
