#!/bin/bash
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -c 4
#SBATCH -t 12:00:00
#SBATCH -o logs/%x-%j.out
# One training run as one long job (normal tier, ≤ 12 h; long jobs are allowed for this project):
#   sbatch -J RUN scripts/train.slrm RUN --coarsen 2 --steps 10000 --seed 0
# 10,000 steps at 100 nm on G1 + G2 + G3 take ~8 h, the final valid and test rollouts ~1 h more.

gto-memcap 12G || exit 1
uv run train.py "$@"
exit $?
