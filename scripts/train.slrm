#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="8:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -o logs/%x-%A.out


set -euo pipefail

CONFIGURATION="flower-constant-embedding"
DATASET="llg_field_switching"
LEARNING_RATE=1e-4
BATCH_SIZE=16
EPOCHS=4
HIDDEN_CHANNELS=32
NUM_BLOCKS=3
SEED=1

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"

echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Epochs=$EPOCHS"
echo "Model: hidden channels=$HIDDEN_CHANNELS, blocks=$NUM_BLOCKS"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed $SEED \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --epochs $EPOCHS \
    --hidden-channels $HIDDEN_CHANNELS \
    --num-blocks $NUM_BLOCKS

uv run eval.py \
    --seed $SEED \
    --dataset $DATASET \
    --configuration $CONFIGURATION
