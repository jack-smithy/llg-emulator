#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="1:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -o logs/%x-%A.out

export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9

set -euo pipefail

CONFIGURATION="flowers-test"
DATASET="llg_field_switching"
LEARNING_RATE=1e-4
BATCH_SIZE=32
EPOCHS=32
HIDDEN_CHANNELS=40
NUM_LEVELS=3
NUM_HEADS=10
SEED=2

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"

echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Epochs=$EPOCHS"
echo "Model: hidden channels=$HIDDEN_CHANNELS, levels=$NUM_LEVELS"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed $SEED \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --epochs $EPOCHS \
    --hidden-channels $HIDDEN_CHANNELS \
    --num-levels $NUM_LEVELS \
    --num-heads $NUM_HEADS

echo "Model Finished Training"

uv run eval.py \
    --seed $SEED \
    --dataset $DATASET \
    --configuration $CONFIGURATION
