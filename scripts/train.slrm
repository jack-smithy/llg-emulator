#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="4:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -o logs/%x-%A.out


set -euo pipefail

CONFIGURATION="baseline-3"
DATASET="llg_field_switching"
IN_FRAMES=4
LEARNING_RATE=1e-3
BATCH_SIZE=16
EPOCHS=8
SEED=1

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"

echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, In frames=$IN_FRAMES"

uv run python -c "import utils; utils.device_info()"

uv run train.py \
    --seed $SEED \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --in-frames $IN_FRAMES \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --epochs $EPOCHS

uv run eval.py \
    --seed $SEED \
    --dataset $DATASET \
    --configuration $CONFIGURATION