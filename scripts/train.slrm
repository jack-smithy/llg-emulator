#!/bin/bash
#
#SBATCH -J train
#SBATCH --time="2:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --requeue
#SBATCH --array=0-3
#SBATCH -o logs/%x-%A_%a.out

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task $SLURM_ARRAY_TASK_ID on GPU(s) $CUDA_VISIBLE_DEVICES"

uv run train.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --configuration tangent_one_step
