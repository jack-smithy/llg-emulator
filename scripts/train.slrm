#!/bin/bash
#
# One recipe, one seed per array task, then its validation scores:
#   sbatch --array=0-1 scripts/train.slrm configs/closure.yaml
# 20k-step recipes need about 12 h on a slice: add -t 16:00:00.
#
#SBATCH -J train
#SBATCH --time="12:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -c 4
#SBATCH --array=0
#SBATCH -o logs/%x-%A_%a.out

set -euo pipefail
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95

CONFIG=$1
RUN="$(basename "$CONFIG" .yaml)/seed_$SLURM_ARRAY_TASK_ID"
echo "$RUN on $SLURM_NODELIST, $(date)"

uv run train.py "$CONFIG" --seed "$SLURM_ARRAY_TASK_ID"
uv run evaluate.py validate --runs "$RUN"
uv run evaluate.py rollouts --runs "$RUN" --films valid256
