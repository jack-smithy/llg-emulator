#!/usr/bin/env bash
# Evaluate a saved model on SP4 rollout + val, append a row to BENCHMARKS.md.
#   scripts/eval weights/best.eqx best
# Picks the lowest-memory GPU automatically.
set -euo pipefail
cd "$(dirname "$0")/.."

WEIGHTS=${1:-weights/best.eqx}
TAG=${2:-best}
GPU=$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
      | sort -t, -k2 -n | head -1 | cut -d, -f1 | tr -d ' ')

CUDA_VISIBLE_DEVICES=$GPU uv run python -m llg_emulator.bench "$WEIGHTS" --tag "$TAG"
