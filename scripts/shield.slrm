#!/bin/bash
#SBATCH --gres=gpu:a100:1
#SBATCH -t 3:00:00
#SBATCH -o logs/%x-%j.out
# One datagen.py run on a gtos3 A100 (float64, from ~1M cells), its arguments passed through, e.g.
#   cd /data/smith/work/llg-emulator && sbatch -J datagen scripts/shield.slrm G1 --split test --n-samples 4
# Set -t to the loops: at 10 nm a G1 loop takes about 25 min on an A100, a G2 loop about 3 h (estimates).
uv run python -u datagen.py "$@"
exit $?
