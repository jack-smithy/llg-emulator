#!/bin/bash
#
#SBATCH -J closure-sweep
#SBATCH --time="20:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -c 8
#SBATCH --mem=24G
#SBATCH --array=0-5
#SBATCH -o logs/%x-%A_%a.out

# Hyperparameter sweep of the learned-closure LLG (model.ClosureEmulator) that trains on
# the native 5 nm cells too (pool factor 1) and up to 80 nm (16). One array task per
# configuration; each trains seed 0, then evaluates: eval.py (one-step validation
# metrics, rollout figures) and eval_scaling's model stage on the validation films
# (`valid256`, for model selection) and the test films. Results under results-closure/.

export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95
export RESULTS_ROOT=results-closure

set -euo pipefail

DATASET="llg_field_switching"
# the recipe of configuration `closure` (scripts/train_closure_array.slrm) + pool factor 1
LEARNING_RATE=3e-4
BATCH_SIZE=16
NUM_STEPS=10000
VAL_EVERY=1000
HIDDEN_CHANNELS=64
NUM_BLOCKS=4
POOL_FACTORS="1 2 4 8 16"  # wave 1; wave 2 drops 16: the target is 5-40 nm for now
UNROLL=8
case $SLURM_ARRAY_TASK_ID in
    0) CONFIGURATION=k1 ;;                                 # the recipe with native cells
    1) CONFIGURATION=k1-wide; HIDDEN_CHANNELS=128 ;;        # twice the channels
    2) CONFIGURATION=k1-deep; NUM_BLOCKS=8 ;;               # twice the blocks (radius 16 cells)
    3) CONFIGURATION=k1-lr1e-3; LEARNING_RATE=1e-3 ;;       # faster schedule
    4) CONFIGURATION=k1-unroll16; UNROLL=16 ;;              # longer training windows
    5) CONFIGURATION=k1-long; NUM_STEPS=20000; VAL_EVERY=2000 ;;  # twice the steps
    # second wave: the two winners of the first (wide: loops and 10 nm; long: validation
    # score) and the runner-up on validation loss, each with the longer schedule
    6) CONFIGURATION=k1-wide-long; HIDDEN_CHANNELS=128; NUM_STEPS=20000; VAL_EVERY=2000; POOL_FACTORS="1 2 4 8" ;;
    7) CONFIGURATION=k1-deep-long; NUM_BLOCKS=8; NUM_STEPS=20000; VAL_EVERY=2000; POOL_FACTORS="1 2 4 8" ;;
    *) echo "no configuration for task $SLURM_ARRAY_TASK_ID"; exit 1 ;;
esac

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task: $SLURM_ARRAY_TASK_ID -> configuration $CONFIGURATION (results in $RESULTS_ROOT)"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Steps=$NUM_STEPS, val every $VAL_EVERY"
echo "Model: classic, hidden channels=$HIDDEN_CHANNELS, blocks=$NUM_BLOCKS, pool factors=$POOL_FACTORS, closure, unroll=$UNROLL, augment"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed 0 \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --num-steps $NUM_STEPS \
    --val-every $VAL_EVERY \
    --hidden-channels $HIDDEN_CHANNELS \
    --arch classic \
    --num-blocks $NUM_BLOCKS \
    --pool-factors $POOL_FACTORS \
    --closure \
    --zero-init \
    --augment \
    --unroll $UNROLL

echo "Model Finished Training"

uv run eval.py --seed 0 --dataset $DATASET --configuration $CONFIGURATION

# rollouts against the cached truth: the validation films for model selection, then
# the test films for the figures
uv run python -m datagen.eval_scaling model --dataset $DATASET \
    --films valid256 sq256 sq512 large --runs $CONFIGURATION/seed_0 --no-speed

# quasi-static in-plane hysteresis loops against the 5 nm reference and the coarse solver
uv run python -m datagen.hysteresis run --dataset $DATASET --runs $CONFIGURATION/seed_0
uv run python -m datagen.hysteresis plot --dataset $DATASET --runs $CONFIGURATION/seed_0
