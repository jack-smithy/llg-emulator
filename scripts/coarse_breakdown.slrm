#!/bin/bash
#
#SBATCH -J coarse-breakdown
#SBATCH --time="5:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -c 8
#SBATCH --mem=32G
#SBATCH -o logs/%x-%j.out

set -euo pipefail

DATASET="llg_field_switching"
FILM="${FILM:-sq256}"  # a film of eval_scaling.FILMS; env FILM=sq512 sbatch ...

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Film: $FILM"

# the CPU plot stage afterwards: uv run python -m datagen.coarse_breakdown plot --film $FILM
# extra arguments pass through, e.g. `sbatch scripts/coarse_breakdown.slrm --ns 5`
uv run python -m datagen.coarse_breakdown run --dataset $DATASET --film $FILM "$@"
