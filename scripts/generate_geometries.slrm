#!/bin/bash
#
#SBATCH -J datagen-geom
#SBATCH --time="16:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --mem=24G
#SBATCH --array=0-7
#SBATCH --requeue
#SBATCH -o logs/%x-%A_%a.out

set -euo pipefail

DATASET="llg_field_switching"

echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"

# one task per geometry, in datagen/generate_geometries.GEOMETRIES order; extra sbatch
# arguments pass through, e.g. `sbatch scripts/generate_geometries.slrm --n-samples 4`
GEOMETRY=$(uv run python -c \
    "import sys; from datagen.generate_geometries import GEOMETRIES; print(list(GEOMETRIES)[int(sys.argv[1])])" \
    "$SLURM_ARRAY_TASK_ID")
echo "Geometry: $GEOMETRY"

uv run python -m datagen.generate_geometries \
    --out datasets/$DATASET/geometries \
    --geometry "$GEOMETRY" "$@"
