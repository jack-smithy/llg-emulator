#!/bin/bash
#
#SBATCH -J train-sil
#SBATCH --time="12:00:00"  # ~2.2 s/step at unroll 16
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --array=0-1
#SBATCH -o logs/%x-%A_%a.out

export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95

set -euo pipefail

DATASET="llg_field_switching"
CONFIGURATION="solver-in-the-loop-unroll16"  # its own results dir; the unroll-8 runs live in solver-in-the-loop
LEARNING_RATE=1e-4  # Um et al.'s Adam rate; 1e-3 diverged (seed 0) or lagged the solver (seed 1)
BATCH_SIZE=16  # with the per-step remat: ~3 GiB at k=2, ~1 s/step averaged over k
NUM_STEPS=10000
VAL_EVERY=1000
HIDDEN_CHANNELS=64
NUM_BLOCKS=2
POOL_FACTORS="2 4 8"  # coarse cells only: at k=1 the solver is the reference itself
UNROLL=16  # SOL-n: steps per training window, gradients through the solver


echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task: $SLURM_ARRAY_TASK_ID"
echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Steps=$NUM_STEPS, val every $VAL_EVERY"
echo "Model: hidden channels=$HIDDEN_CHANNELS, blocks=$NUM_BLOCKS, pool factors=$POOL_FACTORS, solver-in-the-loop unroll=$UNROLL"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --num-steps $NUM_STEPS \
    --val-every $VAL_EVERY \
    --hidden-channels $HIDDEN_CHANNELS \
    --num-blocks $NUM_BLOCKS \
    --pool-factors $POOL_FACTORS \
    --solver-in-the-loop \
    --zero-init \
    --unroll $UNROLL

echo "Model Finished Training"

uv run eval.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --dataset $DATASET \
    --configuration $CONFIGURATION
