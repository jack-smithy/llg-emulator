#!/bin/bash
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH -c 2
#SBATCH -t 3:00:00
#SBATCH -o logs/%x-%j.out
# One link of a chain of short jobs that runs a datagen driver (a python file and its arguments).
# datagen.py checkpoints after every field step and exits with 75 when its TIME_BUDGET (2.75 h) leaves
# trajectories unfinished; only then, and only after progress, does the link resubmit itself with the
# same arguments, so a failing chain stops by itself.
#   cd /data/smith/work/llg-emulator && sbatch -J NAME scripts/datagen_chain.slrm DRIVER.py [ARGS...]
gto-memcap 12G || exit 1
PYTHONPATH=. uv run python -u "$@"
rc=$?
if [ $rc -eq 75 ]; then sbatch -J "$SLURM_JOB_NAME" scripts/datagen_chain.slrm "$@" || exit $?; exit 0; fi
exit $rc
