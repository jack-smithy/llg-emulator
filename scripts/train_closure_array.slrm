#!/bin/bash
#
#SBATCH -J train-closure
#SBATCH --time="12:00:00"
#SBATCH --gres=gpu:1g.24gb:1
#SBATCH --array=0-1
#SBATCH -o logs/%x-%A_%a.out

export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95

set -euo pipefail

DATASET="llg_field_switching"
# the learned-closure LLG (model.ClosureEmulator); the knobs below take environment
# overrides, e.g. the ablation on solver-in-the-loop's own recipe:
#   sbatch --export=ALL,CONFIGURATION=closure-dilated,ARCH=dilated,NUM_BLOCKS=2,LEARNING_RATE=1e-4,AUGMENT=--no-augment scripts/train_closure_array.slrm
CONFIGURATION=${CONFIGURATION:-closure}
LEARNING_RATE=${LEARNING_RATE:-3e-4}
BATCH_SIZE=16
NUM_STEPS=10000
VAL_EVERY=1000
HIDDEN_CHANNELS=64
ARCH=${ARCH:-classic}  # kernel-3 ResNet: a compact stencil, 2 cells of receptive field per block
NUM_BLOCKS=${NUM_BLOCKS:-4}
POOL_FACTORS="2 4 8"  # coarse cells only: at k=1 the solver is the reference itself
UNROLL=8  # steps per training window, gradients through the solver, as solver-in-the-loop
AUGMENT=${AUGMENT:---augment}  # D4 symmetries of the square film (utils.d4)


echo "Job started on $(date)"
echo "Running on node(s): $SLURM_NODELIST"
echo "Array task: $SLURM_ARRAY_TASK_ID"
echo "Dataset: $DATASET"
echo "Training configuration: $CONFIGURATION"
echo "Learning rate=$LEARNING_RATE, Batch size=$BATCH_SIZE, Steps=$NUM_STEPS, val every $VAL_EVERY"
echo "Model: $ARCH, hidden channels=$HIDDEN_CHANNELS, blocks=$NUM_BLOCKS, pool factors=$POOL_FACTORS, closure, unroll=$UNROLL, $AUGMENT"

uv run python -c "import utils; utils.device_info()"

uv run main.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --configuration $CONFIGURATION \
    --dataset $DATASET \
    --learning-rate $LEARNING_RATE \
    --batch-size $BATCH_SIZE \
    --num-steps $NUM_STEPS \
    --val-every $VAL_EVERY \
    --hidden-channels $HIDDEN_CHANNELS \
    --arch $ARCH \
    --num-blocks $NUM_BLOCKS \
    --pool-factors $POOL_FACTORS \
    --closure \
    --zero-init \
    $AUGMENT \
    --unroll $UNROLL

echo "Model Finished Training"

uv run eval.py \
    --seed $SLURM_ARRAY_TASK_ID \
    --dataset $DATASET \
    --configuration $CONFIGURATION
