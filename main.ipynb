   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "xx = np.linspace(0, 2 * np.pi, 101)\n",
    "yy = np.sin(xx)\n",
    "ysigma = np.random.uniform(low=0.01, high=0.2, size=(101))\n",
    "\n",
    "plt.plot(xx, yy)\n",
    "plt.fill_between(xx, yy + ysigma, yy - ysigma, alpha=0.4)"
   ]
  },
